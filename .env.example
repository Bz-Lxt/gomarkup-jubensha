# 复制为 .env 后按需修改。.env 已被 .gitignore 排除，禁止提交。
# 不创建 .env 也能直接 `docker compose up`，compose 内置了开发默认值。

APP_ENV=development
LOG_LEVEL=info

POSTGRES_USER=jbs
POSTGRES_PASSWORD=jbs_dev_pwd
POSTGRES_DB=jubensha

# 生产环境必须替换。长度 >= 32 字节。
JWT_SECRET=dev-only-change-me-please-32bytes-min

# 首次启动是否灌入种子数据（城市/剧本/测试账号/示例房间）
SEED_ON_BOOT=true
